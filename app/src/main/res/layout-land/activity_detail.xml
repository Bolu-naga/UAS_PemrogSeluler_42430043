<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailContainerLand"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/leftDetailPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_glass"
        android:elevation="8dp"
        android:padding="20dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/tvCarHeroIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="FORD"
            android:textColor="@color/ford_cyan"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge" />

        <TextView
            android:id="@+id/tvHeroDetailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digital Showroom View"
            android:textColor="@color/ford_text_soft"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/rightDetailScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rightDetailPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORD DETAIL GARAGE"
                android:textColor="@color/ford_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

            <TextView
                android:id="@+id/tvCarName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ford Mustang GT"
                android:textColor="@color/ford_text_main"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvCarSpec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spesifikasi mobil akan tampil di sini."
                android:textColor="@color/ford_text_soft"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/priceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_price_highlight"
                android:padding="16dp"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/tvPriceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Price"
                    android:textColor="@color/ford_text_soft"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCarPricePreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open detail data"
                    android:textColor="@color/ford_gold"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Kembali ke Garage"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/ford_text_main"
                android:background="@drawable/bg_button_neon"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>