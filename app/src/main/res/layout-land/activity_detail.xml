<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailContainerLand"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_gradient"
    android:padding="18dp">

    <!-- Left Hero Panel -->
    <LinearLayout
        android:id="@+id/leftDetailPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.95"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_glass"
        android:elevation="8dp"
        android:padding="20dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/tvDetailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FORD DETAIL GARAGE"
            android:textColor="@color/ford_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <ImageView
            android:id="@+id/ivDetailCarImage"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:src="@drawable/ford_mustang_gt"
            android:contentDescription="Car Detail Image"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true" />

        <TextView
            android:id="@+id/tvHeroDetailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digital Showroom View"
            android:textColor="@color/ford_text_soft"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvHeroHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Premium garage experience"
            android:textColor="@color/ford_text_muted"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/btnFavoriteDetail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="♡"
            android:textColor="@color/ford_text_soft"
            android:textSize="30sp"
            android:gravity="center"
            android:background="@drawable/bg_badge"
            android:layout_marginTop="22dp" />

    </LinearLayout>

    <!-- Right Detail Panel -->
    <ScrollView
        android:id="@+id/rightDetailScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.45"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rightDetailPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCarName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ford Mustang GT"
                android:textColor="@color/ford_text_main"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCarTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Born to roar. Built to dominate."
                android:textColor="@color/ford_text_soft"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="6dp" />

            <!-- Category and Price -->
            <LinearLayout
                android:id="@+id/categoryPriceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPORT"
                    android:textColor="@color/ford_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <LinearLayout
                    android:id="@+id/priceMiniCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvPriceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimated Price"
                        android:textColor="@color/ford_text_soft"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPriceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 1.200.000.000"
                        android:textColor="@color/ford_gold"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Specs Card -->
            <LinearLayout
                android:id="@+id/specCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:elevation="8dp"
                android:padding="16dp"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/tvSpecTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Performance DNA"
                    android:textColor="@color/ford_text_main"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/specGridOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/engineBox"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_badge"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENGINE"
                            android:textColor="@color/ford_text_soft"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEngineValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.0L V8"
                            android:textColor="@color/ford_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/powerBox"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_badge"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="POWER"
                            android:textColor="@color/ford_text_soft"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPowerValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="480 HP"
                            android:textColor="@color/ford_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/fuelBox"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_badge"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FUEL"
                            android:textColor="@color/ford_text_soft"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFuelValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Petrol"
                            android:textColor="@color/ford_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/specGridTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:id="@+id/transmissionBox"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_badge"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GEARBOX"
                            android:textColor="@color/ford_text_soft"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTransmissionValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10-Speed AT"
                            android:textColor="@color/ford_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/seatCard"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_price_highlight"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SEATS"
                            android:textColor="@color/ford_text_soft"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSeatsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 Seats"
                            android:textColor="@color/ford_gold"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Story Card -->
            <LinearLayout
                android:id="@+id/storyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:elevation="8dp"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvStoryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Garage Notes"
                    android:textColor="@color/ford_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpecDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This Ford machine is selected for drivers who want power, presence, and a bold driving character."
                    android:textColor="@color/ford_text_soft"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:id="@+id/actionButtonRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <Button
                    android:id="@+id/btnGallery"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Gallery"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/ford_blue_neon"
                    android:background="@drawable/bg_button_outline"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnCompare"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Compare"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/ford_blue_neon"
                    android:background="@drawable/bg_button_outline"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/ford_text_main"
                    android:background="@drawable/bg_button_neon"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>